{
    "name": "arifje/craft-app-authenticator",
    "type": "craft-plugin",
	"version": "1.0.0",
    "require": {
        "php": ">=8.0.2",
        "craftcms/cms": "^4.16.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main"
    },
    "autoload": {
        "psr-4": {
            "arifje\\craftappauthenticator\\": "src/"
        }
    },
    "extra": {
        "handle": "_app-authenticator",
        "name": "App Authenticator",
        "developer": "Arjan Brinkman",
        "documentationUrl": "",
        "class": "arifje\\craftappauthenticator\\AppAuthenticator"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.0.2"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}

